{
  "name": "conduit-example",
  "private": true,
  "description": "RealWorld (Conduit) with Hono, Inertia and Preact",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server/dev.ts",
    "build": "vite build && vite build --ssr server/main.ts",
    "start": "node dist/server/main.js",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@adwd/inertia-preact": "workspace:*",
    "@hono/inertia": "^0.8.0",
    "@hono/node-server": "^2.1.1",
    "@inertiajs/core": "^3.7.1",
    "hono": "^4.13.9",
    "marked": "^18.0.14",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.10.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
